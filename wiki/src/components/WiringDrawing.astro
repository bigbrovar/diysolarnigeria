---
// Device-level wiring drawings generated by Project Anor's drawing code
// (github.com/bigbrovar/Project-Anor) and saved as SVG in src/diagrams/anor/.
const files = import.meta.glob('../diagrams/anor/*.svg', { query: '?raw', import: 'default', eager: true });
const { name, caption, kind = 'dc' } = Astro.props;
const svg = files[`../diagrams/anor/${name}.svg`];
if (!svg) throw new Error(`No drawing called "${name}" in src/diagrams/anor/`);
// Show the drawing at its natural size, so a narrow one is not blown up to the full column width.
const width = Number((svg.match(/viewBox="[\d.]+ [\d.]+ ([\d.]+)/) || [])[1] || 900);
---

<figure class="dg dg-wiring">
  <ul class="dg-legend" aria-hidden="true">
    {kind === 'dc' ? (
      <>
        <li><span class="dg-key solar" />Positive</li>
        <li><span class="dg-key none" />Negative</li>
      </>
    ) : (
      <>
        <li><span class="dg-key grid" />Live (L)</li>
        <li><span class="dg-key none" />Neutral (N)</li>
      </>
    )}
    <li><span class="dg-key earth" />Earth</li>
  </ul>
  <div class="dg-scroll" role="img" aria-label={caption}>
    <div style={`min-width:${Math.min(width, 620)}px;max-width:${width}px;margin:0 auto`} set:html={svg} />
  </div>
  <figcaption>{caption}</figcaption>
</figure>
