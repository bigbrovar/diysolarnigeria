---
// Adds the disclaimer to the bottom of every wiki page, above Starlight's own footer.
import Default from '@astrojs/starlight/components/Footer.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<aside class="disclaimer" aria-label="Disclaimer">
  <strong>Not a reference guide.</strong>{' '}
  This wiki shares the experience of members of the DIY Solar Nigeria group. It is general
  information, not professional advice, an engineering design or a standard. Electrical and battery
  work can cause fire, injury or death. Check everything against your equipment's manuals and the
  rules where you live, and use a qualified electrician. The contributors and maintainers accept no
  responsibility for any loss, damage or injury that comes from using it.{' '}
  <a href={`${base}/about/disclaimer/`}>Read the full disclaimer</a>.
</aside>

<Default><slot /></Default>

<style>
  .disclaimer {
    margin-top: 3rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-left: 4px solid var(--sl-color-accent);
    border-radius: 8px;
    font-size: var(--sl-text-sm);
    line-height: 1.6;
    color: var(--sl-color-gray-2);
    background: var(--sl-color-gray-6);
  }
  .disclaimer a {
    color: var(--sl-color-text-accent);
  }
  .disclaimer strong {
    color: var(--sl-color-white);
  }
</style>
